{
  "name": "@nikala-ui/folio",
  "version": "0.15.0",
  "license": "MIT",
  "description": "Zero-config, fast, and elegant documentation engine for SolidJS, built on Nikala UI and Tailwind CSS v4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "folio": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/server/plugin/index.d.ts",
      "import": "./dist/server/plugin/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./content": {
      "types": "./dist/core/content-scanner.d.ts",
      "import": "./dist/core/content-scanner.js"
    },
    "./theme": {
      "types": "./dist/themes/default/index.d.ts",
      "import": "./dist/themes/default/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js"
    },
    "./themes/*": {
      "types": "./dist/themes/*/index.d.ts",
      "import": "./dist/themes/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikala-ui/folio.git"
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "test": "bun test tests",
    "test:browser": "bun tests/ssr-preview.playwright.ts",
    "test:browser-i18n": "bun tests/i18n-browser.playwright.ts",
    "test:browser-hmr": "bun tests/dev-hmr.playwright.ts",
    "test:generated": "bun tests/generated-project.smoke.ts",
    "plugin:perf": "bun scripts/plugin-performance.ts",
    "plugin:memory": "bun scripts/plugin-memory-evidence.ts",
    "package:check": "bun run build && bun scripts/check-package.ts",
    "bundle:check": "bun run docs:build && bun scripts/check-bundle.ts",
    "bump": "bun scripts/bump.ts",
    "build": "bun scripts/build.ts",
    "docs:dev": "bun run build && bun dist/cli/index.js dev",
    "docs:build": "bun run build && bun dist/cli/index.js build -o .docs-dist",
    "docs:preview": "bun run build && bun dist/cli/index.js build -o .docs-dist && bun dist/cli/index.js preview -o .docs-dist",
    "index:search": "bun scripts/index-search.ts",
    "check": "bun run typecheck && bun run build && bun run test && bun run docs:build",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@nikala-ui/cli": "0.12.2",
    "@kobalte/core": "^0.13.12",
    "@mdx-js/mdx": "^3.1.0",
    "@mdx-js/rollup": "^3.1.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tailwindcss/vite": "^4.0.7",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "corvu": "^0.7.2",
    "fs-extra": "^11.3.6",
    "gray-matter": "^4.0.3",
    "lucide-solid": "^1.28.0",
    "picocolors": "^1.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@nikala-ui/folio-algolia": "0.2.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.1",
    "bun-types": "1.4.2",
    "playwright": "1.63.0",
    "solid-js": "^1.9.14",
    "tailwindcss": "^4.0.7",
    "typescript": "^7.0.2"
  }
}
